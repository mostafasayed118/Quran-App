---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrayerCityPage from '../../../components/pages/PrayerCityPage.astro';
import { t } from '../../../lib/strings';
import { getCities, type City } from '../../../lib/cities';
import { getPrayerTimes } from '../../../lib/prayer-times';

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { slug: city.id }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const data = getPrayerTimes(city.id);
const title = `${t('en', 'ptCityTitle').replace('{city}', city.nameEn)} — ${t('en', 'appName')}`;
const description = t('en', 'ptCityDescription').replace('{city}', city.nameEn);
---
<BaseLayout title={title} description={description} locale="en">
  <PrayerCityPage locale="en" data={data} />
</BaseLayout>
