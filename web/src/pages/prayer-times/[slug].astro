---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrayerCityPage from '../../components/pages/PrayerCityPage.astro';
import { t } from '../../lib/strings';
import { getCities, type City } from '../../lib/cities';
import { getPrayerTimes } from '../../lib/prayer-times';

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { slug: city.id }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const data = getPrayerTimes(city.id);
const title = `${t('ar', 'ptCityTitle').replace('{city}', city.nameAr)} — ${t('ar', 'appName')}`;
const description = t('ar', 'ptCityDescription').replace('{city}', city.nameAr);
---
<BaseLayout title={title} description={description}>
  <PrayerCityPage locale="ar" data={data} />
</BaseLayout>
