---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/strings';
---

<BaseLayout
  title={t('ar', 'offlineTitle')}
  description={t('ar', 'offlineLead')}
  locale="ar"
  noindex
>
  <section class="offline">
    <h1>{t('ar', 'offlineTitle')}</h1>
    <p>{t('ar', 'offlineLead')}</p>
    <a href="/">{t('ar', 'offlineHome')}</a>
  </section>
</BaseLayout>

<style>
  .offline {
    width: min(560px, calc(100% - 40px));
    margin-inline: auto;
    padding: 96px 0 120px;
    text-align: center;
  }
  .offline h1 {
    margin: 0 0 12px;
    font-size: 1.6rem;
  }
  .offline p {
    margin: 0 0 28px;
    color: var(--muted-strong);
    line-height: 1.9;
  }
  .offline a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-ink);
    font-weight: 700;
    text-decoration: none;
  }
</style>
