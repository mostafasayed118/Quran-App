---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReaderPage from '../../components/pages/ReaderPage.astro';
import { getSurahs, type Surah } from '../../lib/surahs';
import { t } from '../../lib/strings';
import { arReaderDescription } from '../../lib/landing-content';

export function getStaticPaths() {
  return getSurahs().map((s) => ({ params: { n: String(s.id) }, props: { surah: s } }));
}
const { surah } = Astro.props as { surah: Surah };
const title = `${t('ar', 'surahTitle').replace('{name}', surah.nameAr)} — ${t('ar', 'appName')}`;
---
<BaseLayout title={title} description={arReaderDescription(surah.id, surah.nameAr)} preloadFont={['hafs']} ogImage={`/og/surah/${surah.id}.png`}>
  <ReaderPage locale="ar" surah={surah} />
</BaseLayout>
