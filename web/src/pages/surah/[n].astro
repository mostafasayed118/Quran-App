---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReaderPage from '../../components/pages/ReaderPage.astro';
import surahs from '../../data/surahs.json';
import { arReaderDescription } from '../../lib/landing-content';

export function getStaticPaths() {
  return surahs.surahs.map((s) => ({ params: { n: String(s.id) }, props: { surah: s } }));
}
const { surah } = Astro.props as { surah: (typeof surahs.surahs)[number] };
const title = `سورة ${surah.nameAr} — قرآن يَهدي`;
---
<BaseLayout title={title} description={arReaderDescription(surah.id, surah.nameAr)} preloadFont ogImage={`/og/surah/${surah.id}.png`}>
  <ReaderPage locale="ar" surah={surah} />
</BaseLayout>
