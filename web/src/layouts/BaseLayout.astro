---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MiniPlayer from '../components/MiniPlayer.astro';
import { ClientRouter } from 'astro:transitions';
import { t, type Locale } from '../lib/strings';
import { altLocalePath } from '../lib/landing-content';
import { THEME_KEY } from '../lib/theme';

export type PreloadFont = 'hafs' | 'cairo';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  ogImage?: string;
  /**
   * Fonts to preload. 'cairo' is the site body font and is preloaded on every
   * page, because every page renders Cairo text. 'hafs' is the HafsSmart Quran
   * face and belongs on the pages that render ayah text.
   */
  preloadFont?: readonly PreloadFont[];
}
const {
  title,
  description = 'قرآن يَهدي — اقرأ واستمع وتدبّر، مجاناً وبلا حسابات.',
  locale = 'ar',
  ogImage,
} = Astro.props;
const requestedFont: readonly PreloadFont[] = Astro.props.preloadFont ?? [];
const fonts = new Set<PreloadFont>(['cairo']);
for (const font of requestedFont) fonts.add(font);
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
const alternateAr = new URL(altLocalePath(pathname, 'ar'), Astro.site);
const alternateEn = new URL(altLocalePath(pathname, 'en'), Astro.site);
const ogImageUrl = new URL(ogImage ?? '/og-base.png', Astro.site);
---
<!doctype html>
<html lang={locale} dir={dir} data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="mdajZHhvXdfyv_j0FYVlBHMNKMGQ0hpwzTsKspr7XYk" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={alternateAr} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateAr} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    {fonts.has('cairo') && <link rel="preload" href="/fonts/Cairo-Regular.woff2" as="font" type="font/woff2" crossorigin />}
    {fonts.has('cairo') && <link rel="preload" href="/fonts/Cairo-Bold.woff2" as="font" type="font/woff2" crossorigin />}
    {fonts.has('hafs') && <link rel="preload" href="/fonts/HafsSmart_08.woff2" as="font" type="font/woff2" crossorigin />}
    <script is:inline data-astro-rerun define:vars={{ THEME_KEY }}>
      (function () {
        try {
          var saved = localStorage.getItem(THEME_KEY);
          var sys = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
          document.documentElement.setAttribute('data-theme', saved || sys);
        } catch (e) { /* keep day */ }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skipToContent')}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1"><slot /></main>
    <div id="qy-player-region" transition:persist="qy-player">
      <MiniPlayer locale={locale} />
    </div>
    <Footer locale={locale} />
  </body>
</html>
