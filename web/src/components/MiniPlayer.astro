---
import { t, type Locale } from '../lib/strings';
interface Props { locale?: Locale }
const { locale = 'ar' } = Astro.props;
---
<div class="mini-player" data-qy="bar" data-locale={locale} data-error-label={t(locale, 'playerError')} hidden>
  <audio id="qy-audio" preload="none"></audio>
  <button type="button" class="mp-btn" data-qy="prev" aria-label={t(locale, 'playerPrev')}>⏮</button>
  <button type="button" class="mp-btn mp-main" data-qy="toggle" data-play-label={t(locale, 'playerPlay')} data-pause-label={t(locale, 'playerPause')} aria-label={t(locale, 'playerPlay')}>▶</button>
  <button type="button" class="mp-btn" data-qy="next" aria-label={t(locale, 'playerNext')}>⏭</button>
  <div class="mp-meta">
    <span class="mp-title" data-qy="title"></span>
    <span class="mp-reciter" data-qy="reciter"></span>
  </div>
  <div class="mp-track"><div class="mp-bar" data-qy="seek" role="slider" tabindex="0" aria-label={t(locale, 'playerSeek')} aria-valuemin="0" aria-valuemax="100"><i></i></div></div>
  <span class="mp-time" data-qy="time"></span>
  <button type="button" class="mp-btn" data-qy="close" aria-label={t(locale, 'playerClose')}>✕</button>
</div>
<script>
  import { getPlayer } from '../lib/player';
  import { digitsFor } from '../lib/arabic-digits';
  import type { Locale } from '../lib/strings';
  import { dedupeLabel, type MoshafRow } from '../lib/reciters';

  let dismissed = false;

  function init() {
    const bar = document.querySelector('[data-qy="bar"]') as HTMLElement;
    if (!bar) return;
    if ((bar as unknown as { __qyInit?: boolean }).__qyInit) {
      document.body.classList.toggle('has-player', !bar.hidden);
      return;
    }
    (bar as unknown as { __qyInit?: boolean }).__qyInit = true;
    const player = getPlayer();
    const locale: Locale = bar.dataset.locale === 'en' ? 'en' : 'ar';
    const $ = (sel: string) => bar.querySelector(`[data-qy="${sel}"]`) as HTMLElement;
    const fmt = (s: number) => (Number.isFinite(s) ? digitsFor(Math.floor(s / 60), locale) + ':' + digitsFor(String(Math.floor(s % 60)).padStart(2, '0'), locale) : '');
    const setVisible = (visible: boolean) => {
      bar.hidden = !visible;
      document.body.classList.toggle('has-player', visible);
    };

    const render = () => {
      const st = player.state();
      if (dismissed || !st.row || st.surah === null) { setVisible(false); return; }
      setVisible(true);
      $('title').textContent = st.row.reciterName;
      $('reciter').textContent = dedupeLabel(st.row.moshafName);
      $('time').textContent = st.status === 'error'
        ? (bar.dataset.errorLabel ?? '')
        : st.duration ? `${fmt(st.currentTime)} / ${fmt(st.duration)}` : '';
      const playing = st.status === 'playing';
      $('toggle').textContent = playing ? '⏸' : '▶';
      $('toggle').setAttribute('aria-label', (playing ? $('toggle').dataset.pauseLabel : $('toggle').dataset.playLabel) ?? '');
      const pct = st.duration ? Math.min(100, (st.currentTime / st.duration) * 100) : 0;
      const i = bar.querySelector('[data-qy="seek"] i') as HTMLElement;
      i.style.width = `${pct}%`;
      $('seek').setAttribute('aria-valuenow', String(Math.round(pct)));
    };
    player.subscribe(render);
    $('toggle').addEventListener('click', () => player.toggle());
    $('next').addEventListener('click', () => player.next());
    $('prev').addEventListener('click', () => player.prev());
    $('seek').addEventListener('click', (e) => {
      const rect = $('seek').getBoundingClientRect();
      player.seekRatio(((e as MouseEvent).clientX - rect.left) / rect.width);
    });
    $('seek').addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key !== 'ArrowLeft' && ke.key !== 'ArrowRight') return;
      const st = player.state();
      if (!(st.duration > 0)) return;
      ke.preventDefault();
      player.seekRatio(st.currentTime / st.duration + (ke.key === 'ArrowRight' ? 0.05 : -0.05));
    });
    $('close').addEventListener('click', () => {
      dismissed = true;
      setVisible(false);
      // Never drop keyboard/AT focus to <body> when the bar hides: hand it to the reader's
      // play control, or the main landmark (#main carries tabindex="-1").
      const target =
        document.querySelector<HTMLElement>('[data-qy="reader-play"]') ??
        document.getElementById('main');
      target?.focus();
    });
    document.addEventListener('qy:play', (e) => {
      const { row, surah } = (e as CustomEvent<{ row: MoshafRow; surah: number }>).detail;
      dismissed = false;
      player.play(row, surah);
    });
    document.addEventListener('qy:toggle', () => player.toggle());
    render();
  }
  init();
  document.addEventListener('astro:after-swap', init); // ClientRouter re-entry safety
</script>
