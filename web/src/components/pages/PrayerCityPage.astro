---
import { t, type Locale } from '../../lib/strings';
import { cityLabel } from '../../lib/cities';
import { digitsFor } from '../../lib/arabic-digits';
import { type PrayerTimesData } from '../../lib/prayer-times';
import { formatClock, monthLabel, resolveToday } from '../../lib/prayer-calendar';

interface Props {
  locale?: Locale;
  data: PrayerTimesData;
}
const { locale = 'ar', data } = Astro.props;
const city = data.city;

// SSR "today" is the build date: the page ships the current month pre-highlighted
// and the client re-renders/highlights on month switches (see script below).
const {
  y: todayY,
  m: todayM,
  d: todayD,
  inRange,
  monthIndex: currentIdx,
} = resolveToday(data.months, new Date());
const month = data.months[currentIdx];
const todayISO = `${todayY}-${todayM}-${todayD}`;

const heading = t(locale, 'ptCityTitle').replace('{city}', cityLabel(city, locale));
const altName = cityLabel(city, locale === 'ar' ? 'en' : 'ar');
---

<h1 class="page-title">{heading}</h1>
<p class="pt-city-meta">
  <span class="pt-city-alt">{altName}</span>
  <span class="pt-city-sep" aria-hidden="true">
    ·
  </span>
  <span class="pt-city-tz" dir="ltr">
    {city.tz}
  </span>
</p>
<div
  class="pt-city"
  data-qy="pt-city"
  data-city-id={city.id}
  data-locale={locale}
  data-today={inRange ? todayISO : ''}
  data-current={`${month.y}-${month.m}`}
>
  <div class="pt-controls">
    <label class="pt-month">
      <span>{t(locale, 'ptMonth')}</span>
      <select id="prayer-month-select" name="prayer-month-select" data-qy="pt-month">
        {data.months.map((mo, i) => (
          <option value={`${mo.y}-${mo.m}`} selected={i === currentIdx}>
            {monthLabel(locale, mo.y, mo.m)}
          </option>
        ))}
      </select>
    </label>
    <button type="button" class="rc-btn" data-qy="pt-view-toggle" aria-pressed="false">
      {t(locale, 'ptViewImsakiah')}
    </button>
  </div>
  <div class="pt-table-wrap" data-view="times">
    <table data-qy="pt-table" aria-label={heading}>
      <thead>
        <tr>
          <th data-col="day">{t(locale, 'ptDay')}</th>
          <th data-col="imsak">{t(locale, 'ptImsak')}</th>
          <th data-col="fajr">{t(locale, 'ptFajr')}</th>
          <th data-col="sunrise">{t(locale, 'ptSunrise')}</th>
          <th data-col="dhuhr">{t(locale, 'ptDhuhr')}</th>
          <th data-col="asr">{t(locale, 'ptAsr')}</th>
          <th data-col="maghrib">
            <span class="lbl-times">{t(locale, 'ptMaghrib')}</span>
            <span class="lbl-imsakiah">{t(locale, 'ptIftar')}</span>
          </th>
          <th data-col="isha">{t(locale, 'ptIsha')}</th>
        </tr>
      </thead>
      <tbody>
        {month.days.map((row, i) => {
          const isToday = inRange && i + 1 === todayD;
          return (
            <tr
              data-day={i + 1}
              data-today={isToday ? '1' : undefined}
              class={isToday ? 'is-today' : undefined}
            >
              <td data-col="day">
                {isToday && <span class="sr-only">{`${t(locale, 'ptToday')} `}</span>}
                {digitsFor(i + 1, locale)}
              </td>
              <td data-col="imsak">{formatClock(row[6], locale)}</td>
              <td data-col="fajr">{formatClock(row[0], locale)}</td>
              <td data-col="sunrise">{formatClock(row[1], locale)}</td>
              <td data-col="dhuhr">{formatClock(row[2], locale)}</td>
              <td data-col="asr">{formatClock(row[3], locale)}</td>
              <td data-col="maghrib">{formatClock(row[4], locale)}</td>
              <td data-col="isha">{formatClock(row[5], locale)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="pt-note">{t(locale, 'ptNote')}</p>
</div>
<style is:global>
  /* A ledger page, not a data dump: the month is the running head, the columns are
     ruled like a table in a manuscript, and the /maghrib/ column is the day's hinge
     (the one time a fasting reader looks for first), so it carries the tint. */
  .pt-city-meta {
    display: flex;
    align-items: baseline;
    gap: 7px;
    width: min(760px, calc(100% - 40px));
    margin: 0 auto 6px;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .pt-city-meta .pt-city-alt {
    letter-spacing: 0.03em;
  }
  .pt-city-meta .pt-city-sep {
    opacity: 0.6;
  }
  .pt-city-meta .pt-city-tz {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .pt-city {
    width: min(920px, calc(100% - 40px));
    margin: 0 auto 60px;
  }
  .pt-city .pt-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 16px 0 0;
    padding-bottom: 12px;
    border-bottom: 1px solid color-mix(in srgb, var(--gold-line) 26%, transparent);
  }
  .pt-city .pt-month {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted-strong);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  .pt-city .pt-month select {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--gold-line) 40%, transparent);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
  }
  @media (pointer: coarse) {
    .pt-city .pt-month select {
      min-height: 44px;
    }
  }
  .pt-city .pt-table-wrap {
    overflow-x: auto;
    margin-top: 4px;
    border-top: 2px solid color-mix(in srgb, var(--gold-line) 50%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--gold-line) 30%, transparent);
  }
  .pt-city table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .pt-city th,
  .pt-city td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--hairline);
    text-align: center;
    white-space: nowrap;
  }
  .pt-city th + th,
  .pt-city td + td {
    border-inline-start: 1px solid color-mix(in srgb, var(--gold-line) 10%, transparent);
  }
  .pt-city th {
    padding-block: 10px;
    border-bottom: 1px solid color-mix(in srgb, var(--gold-line) 45%, transparent);
    background: color-mix(in srgb, var(--gold-line) 6%, transparent);
    color: var(--gold-ink);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .pt-city td {
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .pt-city td[data-col='day'] {
    color: var(--muted-strong);
    font-size: 0.88rem;
  }
  .pt-city th[data-col='maghrib'],
  .pt-city td[data-col='maghrib'] {
    background: color-mix(in srgb, var(--gold-line) 7%, transparent);
    color: var(--ink);
    font-weight: 600;
  }
  .pt-city tbody tr:last-child td {
    border-bottom: none;
  }
  @media (hover: hover) {
    .pt-city tbody tr:hover td {
      background: color-mix(in srgb, var(--gold-line) 8%, transparent);
    }
  }
  .pt-city tr.is-today td {
    background: color-mix(in srgb, var(--gold-line) 15%, transparent);
    color: var(--ink);
    font-weight: 700;
  }
  .pt-city tr.is-today td:first-child {
    border-inline-start: 3px solid var(--gold-line);
  }
  .pt-city .lbl-imsakiah {
    display: none;
  }
  .pt-city [data-view='imsakiah'] .lbl-imsakiah {
    display: inline;
  }
  .pt-city [data-view='imsakiah'] .lbl-times {
    display: none;
  }
  .pt-city [data-view='imsakiah'] [data-col='sunrise'],
  .pt-city [data-view='imsakiah'] [data-col='dhuhr'],
  .pt-city [data-view='imsakiah'] [data-col='asr'],
  .pt-city [data-view='imsakiah'] [data-col='isha'] {
    display: none;
  }
  .pt-city .pt-note {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid color-mix(in srgb, var(--gold-line) 14%, transparent);
    color: var(--muted-strong);
    font-size: 0.82rem;
    line-height: 1.85;
  }
  .pt-city .pt-error {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--muted-strong);
  }
</style>
<script>
  import { t, type Locale } from '../../lib/strings';
  import { digitsFor } from '../../lib/arabic-digits';
  import { formatClock } from '../../lib/prayer-calendar';
  import { onPageReady } from '../../lib/lifecycle';

  // Viewer-local calendar day, in the same unpadded shape as the SSR attrs
  // (YYYY-M-D), so the select value and the highlight compare cleanly.
  const localToday = (): string => {
    const d = new Date();
    return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
  };

  function init(): void {
    const root = document.querySelector<HTMLElement>('[data-qy="pt-city"]');
    if (!root || root.dataset.qyReady) return;
    const locale: Locale = root.dataset.locale === 'en' ? 'en' : 'ar';
    const cityId = root.dataset.cityId ?? '';
    let today = localToday() || (root.dataset.today ?? '');
    const select = root.querySelector<HTMLSelectElement>('[data-qy="pt-month"]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-qy="pt-view-toggle"]');
    const wrap = root.querySelector<HTMLElement>('.pt-table-wrap');
    const tbody = root.querySelector<HTMLTableSectionElement>('[data-qy="pt-table"] tbody');
    if (!select || !toggle || !wrap || !tbody || cityId === '') return;
    // The SSR default is the build month; open the viewer's month instead
    // (the option list is the shipped window, so an out-of-range date keeps it).
    const viewerMonth = today.split('-').slice(0, 2).join('-');
    if (Array.from(select.options).some((o) => o.value === viewerMonth)) {
      select.value = viewerMonth;
    }

    let months: { y: number; m: number; days: number[][] }[] | null = null;
    let pending: Promise<void> | null = null;

    const hm = (min: number): string => formatClock(min, locale);

    const cell = (col: string, text: string, srPrefix?: string): HTMLTableCellElement => {
      const td = document.createElement('td');
      td.dataset.col = col;
      if (srPrefix !== undefined) {
        const sr = document.createElement('span');
        sr.className = 'sr-only';
        sr.textContent = `${srPrefix} `;
        td.appendChild(sr);
      }
      td.append(text);
      return td;
    };

    const renderMonth = (): void => {
      if (!months) return;
      const [y, m] = select.value.split('-').map(Number);
      const monthData = months.find((mo) => mo.y === y && mo.m === m);
      if (!monthData) return;
      const todayParts = today === '' ? null : today.split('-').map(Number);
      const todayDay = todayParts && todayParts[0] === y && todayParts[1] === m ? todayParts[2] : 0;
      const rows = monthData.days.map((row, i) => {
        const day = i + 1;
        const tr = document.createElement('tr');
        tr.dataset.day = String(day);
        if (day === todayDay) {
          tr.dataset.today = '1';
          tr.classList.add('is-today');
        }
        tr.append(
          cell('day', digitsFor(day, locale), day === todayDay ? t(locale, 'ptToday') : undefined),
          cell('imsak', hm(row[6])),
          cell('fajr', hm(row[0])),
          cell('sunrise', hm(row[1])),
          cell('dhuhr', hm(row[2])),
          cell('asr', hm(row[3])),
          cell('maghrib', hm(row[4])),
          cell('isha', hm(row[5])),
        );
        return tr;
      });
      tbody.replaceChildren(...rows);
    };

    const renderError = (): void => {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = 8;
      const box = document.createElement('div');
      box.className = 'pt-error';
      const msg = document.createElement('span');
      msg.textContent = t(locale, 'panelError');
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'rc-btn';
      retry.textContent = t(locale, 'panelRetry');
      retry.addEventListener('click', () => {
        void refresh();
      });
      box.append(msg, retry);
      td.appendChild(box);
      tr.appendChild(td);
      tbody.replaceChildren(tr);
    };

    const load = (): Promise<void> => {
      if (months) return Promise.resolve();
      if (!pending) {
        pending = fetch(`/data/prayer-times/${cityId}.json`, { credentials: 'omit' })
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then((data: { months: { y: number; m: number; days: number[][] }[] }) => {
            months = data.months;
          })
          .catch((error: unknown) => {
            pending = null;
            throw error;
          });
      }
      return pending;
    };

    const refresh = (): Promise<void> =>
      load().then(
        () => {
          if (root.isConnected) renderMonth();
        },
        () => {
          if (root.isConnected) renderError();
        },
      );

    select.addEventListener('change', () => {
      void refresh();
    });

    toggle.addEventListener('click', () => {
      const next = wrap.dataset.view === 'imsakiah' ? 'times' : 'imsakiah';
      wrap.dataset.view = next;
      toggle.setAttribute('aria-pressed', String(next === 'imsakiah'));
      toggle.textContent = t(locale, next === 'imsakiah' ? 'ptViewTimes' : 'ptViewImsakiah');
    });

    // Pre-warm the month data, then re-render with the viewer's local date: the
    // SSR table was built on the deploy date, so its highlight can be stale.
    // Month switching is then instant and the imsakiah toggle (pure CSS) keeps
    // working even if the fetch fails.
    void load()
      .then(() => {
        if (root.isConnected) {
          today = localToday();
          renderMonth();
        }
      })
      .catch(() => {});
    root.dataset.qyReady = '1';
  }
  onPageReady(init);
</script>
