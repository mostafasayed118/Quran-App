---
import ResumeCard from '../ResumeCard.astro';
import { t, type Locale } from '../../lib/strings';
import { LANDING, GITHUB_RELEASES_URL } from '../../lib/landing-content';
interface Props { locale?: Locale }
const { locale = 'ar' } = Astro.props;
const copy = LANDING[locale];
const base = locale === 'en' ? '/en' : '';
---
<section class="hero">
  <p class="hero-ayah" lang="ar" dir="rtl">{copy.hero.ayah}</p>
  <p class="hero-ref">{copy.hero.ayahRef}</p>
  <h1 class="hero-kicker">{copy.hero.kicker}</h1>
  <p class="hero-lead">{copy.hero.lead}</p>
  <div class="hero-ctas">
    <a class="rc-btn hero-cta hero-cta-primary" href={`${base}/quran/`}>{copy.hero.ctaPrimary}</a>
    <a class="rc-btn hero-cta" href={`${base}/about/`}>{copy.hero.ctaSecondary}</a>
  </div>
</section>

<ResumeCard locale={locale} />

<section class="features">
  <h2 class="page-title">{t(locale, 'landingFeaturesTitle')}</h2>
  <ul class="feat-grid">
    {copy.features.map((f) => (
      <li class="feat-item">
        <span class="feat-name">{f.title}</span>
        <span class="feat-desc">{f.desc}</span>
      </li>
    ))}
  </ul>
</section>

<section class="promise">
  <ul class="promise-list">
    {copy.promise.map((p) => <li class="promise-item">{p}</li>)}
  </ul>
</section>

<section class="cta">
  <h2 class="cta-title">{copy.cta.title}</h2>
  <p class="cta-lead">{copy.cta.lead}</p>
  <div class="cta-actions">
    <a class="rc-btn cta-github" href={GITHUB_RELEASES_URL} rel="noopener">{copy.cta.githubLabel}</a>
    <span class="cta-play" aria-disabled="true">{copy.cta.playLabel}</span>
  </div>
</section>
<style is:global>
  .hero { max-width: 760px; margin-inline: auto; padding: 46px 20px 6px; text-align: center; }
  .hero-ayah {
    margin: 0 0 4px;
    font-family: 'HafsSmart', serif;
    font-size: clamp(1.5rem, 4.5vw, 2.35rem);
    line-height: 2.1; color: var(--ink);
  }
  .hero-ref { margin: 0 0 24px; color: var(--gold-ink); font-size: .95rem; }
  .hero-kicker { margin: 0 0 10px; font-size: 1.45rem; color: var(--accent); }
  .hero-lead { margin: 0 auto 26px; max-width: 620px; color: var(--muted-strong); line-height: 1.9; }
  .hero-ctas { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; }
  .hero-cta { display: inline-flex; align-items: center; text-decoration: none; }
  .hero-cta-primary { background: var(--btn-bg); color: var(--btn-ink); border-color: transparent; }
  @media (pointer: coarse) { .hero-cta { min-height: 44px; } }
  .features { padding: 26px 0 6px; }
  .feat-grid { list-style: none; margin: 0 auto; padding: 0; max-width: 760px; }
  .feat-item { padding: 12px 4px; border-bottom: 1px solid var(--hairline); }
  .feat-name { display: block; font-weight: 700; color: var(--ink); }
  .feat-desc { display: block; color: var(--muted-strong); font-size: .92rem; line-height: 1.8; }
  @media (min-width: 900px) {
    .features .page-title { width: min(1080px, calc(100% - 40px)); }
    .feat-grid { max-width: 1080px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 36px; }
  }
  .promise { max-width: 1080px; margin: 26px auto 60px; padding: 0 20px; }
  .promise-list {
    list-style: none; margin: 0; padding: 18px 22px;
    display: grid; gap: 12px;
    border: 1px solid var(--gold-line); border-radius: 14px;
  }
  .promise-item { position: relative; padding-inline-start: 18px; color: var(--ink); line-height: 1.8; }
  .promise-item::before {
    content: ''; position: absolute; inset-inline-start: 2px; top: .72em;
    width: 7px; height: 7px; border-radius: 50%; background: var(--gold-line);
  }
  .cta { max-width: 760px; margin: 0 auto 60px; padding: 22px 20px; text-align: center; }
  .cta-title { margin: 0 0 6px; font-size: 1.25rem; color: var(--ink); }
  .cta-lead { margin: 0 0 18px; color: var(--muted-strong); }
  .cta-actions { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 12px; }
  .cta-github {
    display: inline-flex; align-items: center; text-decoration: none;
    background: var(--btn-bg); color: var(--btn-ink); border-color: transparent;
  }
  .cta-play {
    display: inline-flex; align-items: center; padding: 7px 14px; border-radius: 999px;
    border: 1px dashed var(--gold-line); color: var(--muted-strong); font-size: .85rem; font-weight: 700;
  }
  @media (pointer: coarse) { .cta-github { min-height: 44px; } }
</style>
