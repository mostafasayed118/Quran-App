---
import AyahBlock from '../AyahBlock.astro';
import ContentPanel from '../ContentPanel.astro';
import { surahNeighbors } from '../../lib/surah-neighbors';
import { t, type Locale } from '../../lib/strings';
import { surahDisplayName } from '../../lib/surah-name';
import { toArabicDigits } from '../../lib/arabic-digits';
import surahs from '../../data/surahs.json';
interface Props { surah: (typeof surahs.surahs)[number]; locale?: Locale }
const { surah, locale = 'ar' } = Astro.props;
const base = locale === 'en' ? '/en' : '';
const { prev, next } = surahNeighbors(surah.id);
const data = (await import(`../../data/ayahs/${surah.id}.json`)).default as {
  surah: number;
  ayahs: { n: number; juz: number; page: number; u: string; i: string; sajda: boolean }[];
};
---
<script is:inline data-astro-rerun>
  (function () {
    try {
      var s = JSON.parse(localStorage.getItem('qy:reader') || 'null') || {};
      var step = s.fontStep === 1 || s.fontStep === 2 || s.fontStep === 3 ? s.fontStep : 0;
      var view = s.view === 'imlaei' ? 'imlaei' : 'mushaf';
      var layout = s.layout === 'pages' ? 'pages' : 'verses';
      document.documentElement.setAttribute('data-reading-view', view);
      document.documentElement.setAttribute('data-reader-layout', layout);
      document.documentElement.style.setProperty('--reader-step', String(step));
    } catch (e) { /* defaults */ }
  })();
</script>
<article class="reader">
  <header class="reader-head">
    <h1>{locale === 'ar' ? `سورة ${surah.nameAr}` : surahDisplayName(surah, locale)}</h1>
    <p class="meta">{surah.revelationType === 'makkah' ? t(locale, 'chipMeccan') : t(locale, 'chipMedinan')} · {locale === 'en' ? surah.ayahCount : `${toArabicDigits(surah.ayahCount)} آية`}</p>
    <div class="reader-controls" data-locale={locale}>
      <button type="button" class="rc-btn" data-qy-view="mushaf" aria-pressed="true">{t(locale, 'readerViewMushaf')}</button>
      <button type="button" class="rc-btn" data-qy-view="imlaei" aria-pressed="false">{t(locale, 'readerViewImlaei')}</button>
      <button type="button" class="rc-btn" data-qy-layout="verses" aria-pressed="true">{t(locale, 'readerLayoutVerses')}</button>
      <button type="button" class="rc-btn" data-qy-layout="pages" aria-pressed="false">{t(locale, 'readerLayoutPages')}</button>
      <button type="button" class="rc-btn" data-qy-step="-1" aria-label={t(locale, 'readerFontSmaller')}>−</button>
      <button type="button" class="rc-btn" data-qy-step="1" aria-label={t(locale, 'readerFontBigger')}>＋</button>
      <button type="button" class="rc-btn" data-qy="panel-toggle" aria-pressed="false" aria-controls="qy-content-panel">{t(locale, 'panelTitle')}</button>
    </div>
    <div class="reader-listen">
      <select id="reader-reciter-select" name="reader-reciter-select" data-qy="reciter-pick" aria-label={t(locale, 'readerPickReciter')} disabled></select>
      <button type="button" class="rc-btn" data-qy="reader-play" data-surah={surah.id}>{t(locale, 'readerPlay')}</button>
    </div>
  </header>
  <ContentPanel surah={surah.id} locale={locale} />
  <div class="ayahs">
    {data.ayahs.map((a) => <AyahBlock surah={surah.id} n={a.n} page={a.page} textUthmani={a.u} textImlaei={a.i} sajda={a.sajda} locale={locale} />)}
  </div>
  <nav class="reader-nav">
    {prev !== null ? <a href={`${base}/surah/${prev}/`}>{t(locale, 'readerPrev')}</a> : <a href={`${base}/quran/`}>{t(locale, 'backToIndex')}</a>}
    {next !== null && <a href={`${base}/surah/${next}/`}>{t(locale, 'readerNext')}</a>}
  </nav>
</article>
<style is:global>
  html[dir='ltr'] .reader .ayah-text { direction: rtl; }
  [data-reader-layout='pages'] .ayah.selected .ayah-actions { opacity: 1; }
  .reader-controls { flex-wrap: wrap; }
</style>
<script>
  import {
    readReaderSettings,
    writeReaderSettings,
    type FontStep,
    type ReaderSettings,
  } from '../../lib/reader-settings';
  import { fetchReciters, fetchRecitersSnapshot, sortReciters, type MoshafRow } from '../../lib/reciters';
  import { dedupeLabel } from '../../lib/labels';
  import { listBookmarks, toggleBookmark } from '../../lib/bookmarks';
  import { readResume, writeResume } from '../../lib/reader-resume';
  import { shareOrCopy } from '../../lib/share';
  import { surahUrl } from '../../lib/urls';
  import { t, type Locale } from '../../lib/strings';
  import { toArabicDigits } from '../../lib/arabic-digits';

  let L: Locale = 'ar';

  function clampStep(n: number): FontStep {
    return (n < 0 ? 0 : n > 3 ? 3 : n) as FontStep;
  }

  interface PageBlock {
    page: number;
    el: HTMLElement;
    ayahs: HTMLElement[];
  }

  // One module-level keydown listener for pages navigation; the active reader sets keyNav
  // and the before-swap cleanup clears it (same lifecycle as the resume observer).
  let keyNav: { box: HTMLElement; go: (delta: number) => void } | null = null;
  document.addEventListener('keydown', (e) => {
    if (!keyNav || !keyNav.box.isConnected) return;
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, select, textarea, [contenteditable]')) return;
    const forward =
      document.documentElement.lang === 'en' ? e.key === 'ArrowRight' : e.key === 'ArrowLeft';
    keyNav.go(forward ? 1 : -1);
    e.preventDefault();
  });

  // Reciter rows are fetched once per page load and reused by the picker and listen actions.
  let rowsPromise: Promise<MoshafRow[]> | null = null;
  let resolvedRows: MoshafRow[] | null = null;
  function loadRows(): Promise<MoshafRow[]> {
    rowsPromise ??= fetchReciters()
      .then((rows) => (resolvedRows = sortReciters(rows)))
      .catch(() => (resolvedRows = [] as MoshafRow[]));
    return rowsPromise;
  }

  function init() {
    const box = document.querySelector<HTMLElement>('.reader-controls');
    if (!box || box.dataset.qyReady) return;
    L = box.dataset.locale === 'en' ? 'en' : 'ar';
    box.dataset.qyReady = '1';
    let settings: ReaderSettings = readReaderSettings();

    const pick = document.querySelector<HTMLSelectElement>('[data-qy="reciter-pick"]');
    const playBtn = document.querySelector<HTMLButtonElement>('[data-qy="reader-play"]');
    const ayahs = document.querySelector<HTMLElement>('.ayahs');
    const reader = document.querySelector<HTMLElement>('.reader');

    const render = () => {
      document.documentElement.setAttribute('data-reading-view', settings.view);
      document.documentElement.setAttribute(
        'data-reader-layout',
        settings.layout === 'pages' ? 'pages' : 'verses',
      );
      document.documentElement.style.setProperty('--reader-step', String(settings.fontStep));
      box.querySelectorAll<HTMLButtonElement>('[data-qy-view]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.qyView === settings.view));
      });
      const activeLayout = settings.layout === 'pages' ? 'pages' : 'verses';
      box.querySelectorAll<HTMLButtonElement>('[data-qy-layout]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.qyLayout === activeLayout));
      });
    };

    // --- header picker + play (featured-first via sortReciters) ---
    const selectedRow = async (): Promise<MoshafRow | undefined> => {
      const wanted = pick?.value || settings.reciterRow;
      if (wanted) {
        const fromLive = resolvedRows?.find((r) => r.rowId === wanted);
        if (fromLive) return fromLive;
        const fromSnap = sortReciters(await fetchRecitersSnapshot()).find((r) => r.rowId === wanted);
        if (fromSnap) return fromSnap;
      }
      const rows = await loadRows();
      return rows.find((r) => r.rowId === wanted) ?? rows[0];
    };
    const playSurah = async (s: number): Promise<void> => {
      if (!Number.isFinite(s)) return;
      const row = await selectedRow();
      if (row) document.dispatchEvent(new CustomEvent('qy:play', { detail: { row, surah: s } }));
    };
    if (pick) {
      loadRows().then((rows) => {
        pick.replaceChildren(
          ...rows.map((r) => {
            const opt = document.createElement('option');
            opt.value = r.rowId;
            opt.textContent = `${r.reciterName} — ${dedupeLabel(r.moshafName)}`;
            return opt;
          }),
        );
        const stored = settings.reciterRow;
        if (stored && rows.some((r) => r.rowId === stored)) pick.value = stored;
        pick.disabled = rows.length === 0;
      });
      pick.addEventListener('change', () => { settings = writeReaderSettings({ reciterRow: pick.value }); });
    }
    playBtn?.addEventListener('click', () => {
      void playSurah(Number(playBtn.dataset.surah));
    });

    box.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest('button');
      if (!btn) return;
      const view = btn.dataset.qyView;
      const layout = btn.dataset.qyLayout;
      if (view === 'mushaf' || view === 'imlaei') {
        settings = writeReaderSettings({ view });
        render();
      } else if (layout === 'verses' || layout === 'pages') {
        settings = writeReaderSettings({ layout });
        render();
        applyLayoutMode();
      } else {
        const delta = Number(btn.dataset.qyStep);
        if (Number.isFinite(delta) && delta !== 0) {
          settings = writeReaderSettings({ fontStep: clampStep(settings.fontStep + delta) });
        }
        render();
      }
    });

    // --- per-ayah actions (delegated; copy/share always use the plain-Arabic `.ayah-i`) ---
    const saved = new Set(listBookmarks().map((b) => `${b.s}:${b.a}`));
    const setBookmarkState = (btn: HTMLButtonElement, pressed: boolean): void => {
      const label = t(L, pressed ? 'ayahBookmarked' : 'ayahBookmark');
      btn.setAttribute('aria-pressed', String(pressed));
      btn.setAttribute('aria-label', label);
      btn.textContent = label;
    };
    ayahs?.querySelectorAll<HTMLButtonElement>('[data-ayah-action="bookmark"]').forEach((btn) => {
      setBookmarkState(btn, saved.has(`${btn.dataset.surah}:${btn.dataset.ayah}`));
    });

    const flashTimers = new WeakMap<HTMLElement, number>();
    const flashCopied = (btn: HTMLElement): void => {
      if (btn.dataset.origLabel === undefined) btn.dataset.origLabel = btn.textContent ?? '';
      btn.textContent = t(L, 'ayahCopied');
      window.clearTimeout(flashTimers.get(btn));
      flashTimers.set(
        btn,
        window.setTimeout(() => {
          btn.textContent = btn.dataset.origLabel ?? '';
          delete btn.dataset.origLabel;
        }, 1500),
      );
    };

    ayahs?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-ayah-action]');
      if (!btn) return;
      const s = Number(btn.dataset.surah);
      const a = Number(btn.dataset.ayah);
      const text = btn.closest('.ayah')?.querySelector('.ayah-i')?.textContent ?? '';
      const action = btn.dataset.ayahAction;
      if (action === 'copy') {
        navigator.clipboard
          .writeText(text)
          .then(() => flashCopied(btn))
          .catch(() => { /* clipboard unavailable */ });
      } else if (action === 'share') {
        shareOrCopy(surahUrl(document.documentElement.lang === 'en' ? 'en' : 'ar', s, a), text)
          .then((outcome) => {
            if (outcome === 'copied') flashCopied(btn);
          })
          .catch(() => { /* clipboard unavailable */ });
      } else if (action === 'bookmark') {
        setBookmarkState(btn, toggleBookmark(s, a));
      } else if (action === 'listen') {
        void playSurah(s);
      }
    });

    // --- pages layout: tap an ayah to reveal its actions (one at a time; tap again/outside clears) ---
    ayahs?.addEventListener('click', (e) => {
      if (settings.layout !== 'pages') return;
      const target = e.target as HTMLElement | null;
      if (!target || target.closest('[data-ayah-action]')) return;
      const picked = target.closest<HTMLElement>('.ayah');
      const current = ayahs?.querySelector<HTMLElement>('.ayah.selected') ?? null;
      if (picked && picked !== current) {
        current?.classList.remove('selected');
        picked.classList.add('selected');
      } else {
        current?.classList.remove('selected');
      }
    });

    // --- pages layout: cards built in place from the SSR ayah elements; one page shown at a time ---
    let pages: PageBlock[] | null = null;
    let currentIndex = 0;
    let nav: HTMLElement | null = null;
    let posEl: HTMLElement | null = null;
    let prevPageBtn: HTMLButtonElement | null = null;
    let nextPageBtn: HTMLButtonElement | null = null;

    const pageOf = (page: number, total: number): string => {
      const x = L === 'ar' ? toArabicDigits(page) : String(page);
      const y = L === 'ar' ? toArabicDigits(total) : String(total);
      return t(L, 'readerPageOf').replace('{x}', x).replace('{y}', y);
    };

    const buildPages = (container: HTMLElement): PageBlock[] => {
      const byPage = new Map<number, HTMLElement[]>();
      for (const el of Array.from(container.querySelectorAll<HTMLElement>('.ayah'))) {
        const p = Number(el.dataset.page);
        if (!Number.isInteger(p)) continue;
        const list = byPage.get(p);
        if (list) list.push(el);
        else byPage.set(p, [el]);
      }
      const built: PageBlock[] = [];
      for (const page of [...byPage.keys()].sort((x, y) => x - y)) {
        const list = byPage.get(page)!;
        list.sort((x, y) => Number(x.dataset.n) - Number(y.dataset.n));
        const el = document.createElement('div');
        el.className = 'mushaf-page';
        el.setAttribute('data-page', String(page));
        for (const ayah of list) el.appendChild(ayah);
        const num = document.createElement('div');
        num.className = 'mushaf-page-num';
        num.setAttribute('aria-hidden', 'true');
        num.textContent = toArabicDigits(page);
        el.appendChild(num);
        container.appendChild(el);
        built.push({ page, el, ayahs: list });
      }
      return built;
    };

    const indexOfAyah = (n: number): number => {
      if (!pages) return 0;
      const i = pages.findIndex((block) => block.ayahs.some((el) => Number(el.dataset.n) === n));
      return i === -1 ? 0 : i;
    };

    const clearSelection = (): void => {
      ayahs?.querySelector<HTMLElement>('.ayah.selected')?.classList.remove('selected');
    };

    const showPage = (index: number, opts: { scroll?: boolean } = {}): void => {
      if (!pages || pages.length === 0) return;
      const i = Math.min(Math.max(index, 0), pages.length - 1);
      currentIndex = i;
      pages.forEach((block, j) => block.el.toggleAttribute('hidden', j !== i));
      const total = pages.length;
      if (posEl) posEl.textContent = pageOf(pages[i].page, total);
      if (prevPageBtn) {
        prevPageBtn.disabled = i === 0;
        prevPageBtn.setAttribute('aria-label', pageOf(pages[Math.max(i - 1, 0)].page, total));
      }
      if (nextPageBtn) {
        nextPageBtn.disabled = i === total - 1;
        nextPageBtn.setAttribute(
          'aria-label',
          pageOf(pages[Math.min(i + 1, total - 1)].page, total),
        );
      }
      if (nav) nav.hidden = false;
      clearSelection();
      const a = Number(pages[i].ayahs[0]?.dataset.n);
      if (Number.isInteger(a) && Number.isInteger(surahId)) {
        writeResume(localStorage, { s: surahId, a });
      }
      if (opts.scroll === true) reader?.scrollIntoView({ block: 'start' });
    };

    const stepPage = (delta: number): void => {
      if (!pages) return;
      const next = currentIndex + delta;
      if (next < 0 || next >= pages.length) return;
      showPage(next, { scroll: true });
    };

    const buildNav = (container: HTMLElement): void => {
      if (nav) return;
      nav = document.createElement('div');
      nav.className = 'mushaf-nav';
      nav.hidden = true;
      const makeBtn = (dir: 'prev' | 'next'): HTMLButtonElement => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'rc-btn';
        b.setAttribute('data-mushaf', dir);
        b.textContent = dir === 'prev' ? (L === 'ar' ? '›' : '‹') : L === 'ar' ? '‹' : '›';
        b.addEventListener('click', () => stepPage(dir === 'prev' ? -1 : 1));
        return b;
      };
      prevPageBtn = makeBtn('prev');
      nextPageBtn = makeBtn('next');
      posEl = document.createElement('span');
      posEl.className = 'mushaf-pos';
      posEl.setAttribute('data-mushaf', 'pos');
      posEl.setAttribute('aria-live', 'polite');
      nav.append(prevPageBtn, posEl, nextPageBtn);
      container.appendChild(nav);
    };

    const enterPages = (
      target: number | null,
      opts: { scroll?: boolean; anchor?: boolean } = {},
    ): void => {
      const container = ayahs;
      if (!container) return;
      if (!pages) pages = buildPages(container);
      if (pages.length === 0) return;
      buildNav(container);
      showPage(target === null ? 0 : indexOfAyah(target), { scroll: opts.scroll === true });
      keyNav = { box, go: stepPage };
      if (opts.anchor === true && target !== null) {
        document.getElementById(`ayah-${target}`)?.scrollIntoView({ block: 'start' });
      }
    };

    const exitPages = (): void => {
      if (pages) for (const block of pages) block.el.removeAttribute('hidden');
      if (nav) nav.hidden = true;
      clearSelection();
      keyNav = null;
    };

    const topmostVisibleAyah = (container: HTMLElement): number | null => {
      const els = Array.from(container.querySelectorAll<HTMLElement>('.ayah'));
      const top = els.find((el) => el.getBoundingClientRect().bottom > 0);
      const n = Number((top ?? els[0])?.dataset.n);
      return Number.isInteger(n) ? n : null;
    };

    // --- resume point: qy:last-read keeps the topmost visible ayah (throttled ~1s; verses mode) ---
    const surahId = Number(playBtn?.dataset.surah);
    const blocks = Array.from(ayahs?.querySelectorAll<HTMLElement>('.ayah') ?? []);
    const readerActive = Number.isInteger(surahId) && blocks.length > 0;

    const visible = new Set<HTMLElement>();
    let observer: IntersectionObserver | null = null;
    let flushTimer = 0;
    const stopObserver = (): void => {
      window.clearTimeout(flushTimer);
      flushTimer = 0;
      observer?.disconnect();
      observer = null;
    };
    const flush = (): void => {
      flushTimer = 0;
      if (!box.isConnected) return; // a ClientRouter swap already moved on
      const top = blocks.find((el) => visible.has(el));
      const a = Number(top?.dataset.n);
      if (Number.isInteger(a)) writeResume(localStorage, { s: surahId, a });
    };
    const startObserver = (): void => {
      if (!readerActive) return;
      stopObserver();
      const next = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target as HTMLElement);
          else visible.delete(entry.target as HTMLElement);
        }
        if (flushTimer === 0) flushTimer = window.setTimeout(flush, 1000);
      });
      for (const el of blocks) next.observe(el);
      observer = next;
    };
    const applyLayoutMode = (): void => {
      const container = ayahs;
      if (!container) return;
      if (settings.layout === 'pages') {
        stopObserver();
        enterPages(topmostVisibleAyah(container), { scroll: true });
      } else {
        exitPages();
        startObserver();
      }
    };

    try {
      if (readerActive) {
        if (settings.layout === 'pages') {
          const m = /^#ayah-(\d+)$/.exec(location.hash);
          const hashTarget = m ? Number(m[1]) : null;
          let target = hashTarget;
          if (target === null) {
            const stored = readResume(localStorage);
            if (stored !== null && stored.s === surahId) target = stored.a;
          }
          enterPages(target, { anchor: hashTarget !== null });
        } else {
          writeResume(localStorage, { s: surahId, a: 1 });
          startObserver();
        }
        // ClientRouter swap: never let this surah's flush, observer or key nav outlive the page
        document.addEventListener(
          'astro:before-swap',
          () => {
            stopObserver();
            keyNav = null;
          },
          { once: true },
        );
      }
    } catch {
      /* storage or observer unavailable — reader keeps working */
    }

    render();
  }
  init();
  document.addEventListener('astro:after-swap', init); // ClientRouter re-entry safety
</script>
