---
import AyahBlock from '../AyahBlock.astro';
import ContentPanel from '../ContentPanel.astro';
import { surahNeighbors } from '../../lib/surah-neighbors';
import { t, type Locale } from '../../lib/strings';
import { surahDisplayName } from '../../lib/surah-name';
import { toArabicDigits } from '../../lib/arabic-digits';
import { getAyahs } from '../../lib/ayahs';
import {
  READER_SETTINGS_KEY,
  READER_FONT_STEPS,
  READER_VIEWS,
  READER_LAYOUTS,
} from '../../lib/reader-settings';
import type { Surah } from '../../lib/surahs';
interface Props {
  surah: Surah;
  locale?: Locale;
  translations?: ReadonlyMap<number, string>;
}
const { surah, locale = 'ar', translations } = Astro.props;
const base = locale === 'en' ? '/en' : '';
const { prev, next } = surahNeighbors(surah.id);
const data = await getAyahs(surah.id);
---

<script
  is:inline
  data-astro-rerun
  define:vars={{ READER_SETTINGS_KEY, READER_FONT_STEPS, READER_VIEWS, READER_LAYOUTS }}
>
  (function () {
    try {
      // The stored settings come from src/lib/reader-settings.ts: the key and the
      // allowed values are injected above, so this block never re-defines them.
      var s = JSON.parse(localStorage.getItem(READER_SETTINGS_KEY) || 'null') || {};
      var step = READER_FONT_STEPS.indexOf(s.fontStep) >= 0 ? s.fontStep : 0;
      var view = READER_VIEWS.indexOf(s.view) >= 0 ? s.view : 'mushaf';
      var layout = READER_LAYOUTS.indexOf(s.layout) >= 0 ? s.layout : 'verses';
      document.documentElement.setAttribute('data-reading-view', view);
      document.documentElement.setAttribute('data-reader-layout', layout);
      document.documentElement.setAttribute('data-reader-step', String(step));
    } catch (e) {
      /* defaults */
    }
  })();
</script>
<article class="reader">
  <header class="reader-head">
    <h1>
      {locale === 'ar'
        ? t(locale, 'surahTitle').replace('{name}', surah.nameAr)
        : surahDisplayName(surah, locale)}
    </h1>
    <p class="meta">
      {surah.revelationType === 'makkah' ? t(locale, 'chipMeccan') : t(locale, 'chipMedinan')} ·{' '}
      {t(locale, 'ayahCount').replace(
        '{n}',
        locale === 'en' ? String(surah.ayahCount) : toArabicDigits(surah.ayahCount),
      )}
    </p>
    <div class="reader-controls" data-locale={locale}>
      <button type="button" class="rc-btn" data-qy-view="mushaf" aria-pressed="true">
        {t(locale, 'readerViewMushaf')}
      </button>
      <button type="button" class="rc-btn" data-qy-view="imlaei" aria-pressed="false">
        {t(locale, 'readerViewImlaei')}
      </button>
      <button type="button" class="rc-btn" data-qy-layout="verses" aria-pressed="true">
        {t(locale, 'readerLayoutVerses')}
      </button>
      <button type="button" class="rc-btn" data-qy-layout="pages" aria-pressed="false">
        {t(locale, 'readerLayoutPages')}
      </button>
      <button
        type="button"
        class="rc-btn"
        data-qy-step="-1"
        aria-label={t(locale, 'readerFontSmaller')}
      >
        −
      </button>
      <button
        type="button"
        class="rc-btn"
        data-qy-step="1"
        aria-label={t(locale, 'readerFontBigger')}
      >
        ＋
      </button>
      <button
        type="button"
        class="rc-btn"
        data-qy="panel-toggle"
        aria-pressed="false"
        aria-controls="qy-content-panel"
      >
        {t(locale, 'panelTitle')}
      </button>
    </div>
    <div class="reader-listen">
      <select
        id="reader-reciter-select"
        name="reader-reciter-select"
        data-qy="reciter-pick"
        aria-label={t(locale, 'readerPickReciter')}
        disabled
      ></select>
      <button type="button" class="rc-btn" data-qy="reader-play" data-surah={surah.id}>
        {t(locale, 'readerPlay')}
      </button>
    </div>
  </header>
  <ContentPanel surah={surah.id} locale={locale} />
  <div class="ayahs">
    {data.ayahs.map((a) => (
      <AyahBlock
        surah={surah.id}
        n={a.n}
        page={a.page}
        textUthmani={a.u}
        textImlaei={a.i}
        sajda={a.sajda}
        locale={locale}
        translation={translations?.get(a.n)}
      />
    ))}
  </div>
  <nav class="reader-nav">
    {prev !== null ? (
      <a href={`${base}/surah/${prev}/`}>{t(locale, 'readerPrev')}</a>
    ) : (
      <a href={`${base}/quran/`}>{t(locale, 'backToIndex')}</a>
    )}
    {next !== null && <a href={`${base}/surah/${next}/`}>{t(locale, 'readerNext')}</a>}
  </nav>
</article>
<style is:global>
  html[dir='ltr'] .reader .ayah-text {
    direction: rtl;
  }
  [data-reader-layout='pages'] .ayah.selected .ayah-actions {
    opacity: 1;
  }
  .reader-controls {
    flex-wrap: wrap;
  }
</style>
<script>
  import {
    readReaderSettings,
    writeReaderSettings,
    type FontStep,
    type ReaderSettings,
  } from '../../lib/reader-settings';
  import { readResume, writeResume } from '../../lib/reader-resume';
  import { onPageReady } from '../../lib/lifecycle';
  import { initReciterPicker } from '../../lib/reader/reciter-picker';
  import { initAyahActions } from '../../lib/reader/ayah-actions';
  import { initPageCards } from '../../lib/reader/page-cards';
  import { initKeyboardNav } from '../../lib/reader/keyboard-nav';
  import { initResumeObserver } from '../../lib/reader/resume-observer';
  import type { ReaderContext } from '../../lib/reader/context';
  import type { Locale } from '../../lib/strings';

  function clampStep(n: number): FontStep {
    return (n < 0 ? 0 : n > 3 ? 3 : n) as FontStep;
  }

  function init() {
    const box = document.querySelector<HTMLElement>('.reader-controls');
    if (!box || box.dataset.qyReady) return;
    const locale: Locale = box.dataset.locale === 'en' ? 'en' : 'ar';
    box.dataset.qyReady = '1';
    let settings: ReaderSettings = readReaderSettings();

    const ayahs = document.querySelector<HTMLElement>('.ayahs');
    const reader = document.querySelector<HTMLElement>('.reader');
    const playBtn = document.querySelector<HTMLButtonElement>('[data-qy="reader-play"]');
    const surahId = Number(playBtn?.dataset.surah);

    const render = (): void => {
      document.documentElement.setAttribute('data-reading-view', settings.view);
      document.documentElement.setAttribute(
        'data-reader-layout',
        settings.layout === 'pages' ? 'pages' : 'verses',
      );
      document.documentElement.setAttribute('data-reader-step', String(settings.fontStep));
      box.querySelectorAll<HTMLButtonElement>('[data-qy-view]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.qyView === settings.view));
      });
      const activeLayout = settings.layout === 'pages' ? 'pages' : 'verses';
      box.querySelectorAll<HTMLButtonElement>('[data-qy-layout]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.qyLayout === activeLayout));
      });
    };

    const saveSettings = (patch: Partial<ReaderSettings>): ReaderSettings => {
      settings = writeReaderSettings(patch);
      return settings;
    };

    const ctx: ReaderContext = {
      locale,
      box,
      ayahs,
      reader,
      surahId,
      settings: () => settings,
      saveSettings,
      render,
    };

    // --- header picker + play (featured-first via sortReciters) ---
    const picker = initReciterPicker(ctx);
    initAyahActions({
      context: ctx,
      playSurah: (s) => {
        void picker.playSurah(s);
      },
    });
    const keyboard = initKeyboardNav();
    const pages = initPageCards(ctx, keyboard);
    const observer = initResumeObserver(ctx);

    const applyLayoutMode = (): void => {
      if (!ctx.ayahs) return;
      if (settings.layout === 'pages') {
        observer.stop();
        pages.enterPages(pages.topmostVisibleAyah(), { scroll: true });
      } else {
        pages.exitPages();
        observer.start();
      }
    };

    box.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest('button');
      if (!btn) return;
      const view = btn.dataset.qyView;
      const layout = btn.dataset.qyLayout;
      if (view === 'mushaf' || view === 'imlaei') {
        saveSettings({ view });
        render();
      } else if (layout === 'verses' || layout === 'pages') {
        saveSettings({ layout });
        render();
        applyLayoutMode();
      } else {
        const delta = Number(btn.dataset.qyStep);
        if (Number.isFinite(delta) && delta !== 0) {
          saveSettings({ fontStep: clampStep(settings.fontStep + delta) });
        }
        render();
      }
    });

    try {
      if (observer.active) {
        if (settings.layout === 'pages') {
          const m = /^#ayah-(\d+)$/.exec(location.hash);
          const hashTarget = m ? Number(m[1]) : null;
          let target = hashTarget;
          if (target === null) {
            const stored = readResume(localStorage);
            if (stored !== null && stored.s === surahId) target = stored.a;
          }
          pages.enterPages(target, { anchor: hashTarget !== null });
        } else {
          writeResume(localStorage, { s: surahId, a: 1 });
          observer.start();
        }
        // ClientRouter swap: never let this surah's flush, observer or key nav outlive the page
        document.addEventListener(
          'astro:before-swap',
          () => {
            observer.stop();
            keyboard.set(null);
          },
          { once: true },
        );
      }
    } catch {
      /* storage or observer unavailable — reader keeps working */
    }

    render();
  }
  onPageReady(init);
</script>
