/*
# script-src/style-src 'unsafe-inline' is a deliberate accepted risk (owner-approved 2026-10-19):
# Astro's built-in CSP (security.csp) is incompatible with <ClientRouter/>, and per-page hash
# management across ~240 static pages is not viable. Revisit if Astro ever supports both. See ledger.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://mp3quran.net https://*.mp3quran.net; connect-src 'self' https://mp3quran.net https://*.mp3quran.net https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# /fonts/* is unhashed with a 7-day TTL (owner-approved 2026-10-19): font files are stable; if one
# ever changes, RENAME it (e.g. -v2) for an instant cache-bust — the TTL is only the fallback.
/fonts/*
  Cache-Control: public, max-age=604800

