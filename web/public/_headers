/*
# script-src no longer allows 'unsafe-inline' (owner-ordered 2026-10-20; the 2026-10-19
# accepted risk is closed). The four inline scripts that remain are allowed by their exact
# sha256 of the shipped bytes instead:
#   sha256-AnzapHv9e0FxfksgdGJDNsvKUkF94GoY/QLAIBB97oc=  BaseLayout theme bootstrap  (every page)
#   sha256-Tu0eJMEhDefobbaYOSa3rc7wWgdtrs2mDp1xVB9KND8=  ThemeToggle wiring           (every page)
#   sha256-uerf+14rw7uirgLFiZ6294niB3btAhfAbE4JnvcdCiM=  404 AR/EN swap             (dist/404.html)
#   sha256-eQeWf9nAb2z3bok3TioN0efE0j8504fNkApEhKn9Lqg=  reader reading view/layout (the surah pages)
# All four must run before the first paint (theme, toggle label, reading view, 404 locale), so
# they cannot be deferred into a module; and Astro's build inlines every component script under
# 4KB with no imports, so converting them would not yield an external 'self' asset either.
# `npm run budget` recomputes these hashes from the built HTML and fails the gate if one drifts.
# style-src needs no 'unsafe-inline' either: astro.config.mjs sets
# `build.inlineStylesheets: 'never'`, so every component stylesheet ships as a hashed
# /_astro/*.css file.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-AnzapHv9e0FxfksgdGJDNsvKUkF94GoY/QLAIBB97oc=' 'sha256-Tu0eJMEhDefobbaYOSa3rc7wWgdtrs2mDp1xVB9KND8=' 'sha256-uerf+14rw7uirgLFiZ6294niB3btAhfAbE4JnvcdCiM=' 'sha256-eQeWf9nAb2z3bok3TioN0efE0j8504fNkApEhKn9Lqg='; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self' https://mp3quran.net https://*.mp3quran.net; connect-src 'self' https://mp3quran.net https://*.mp3quran.net https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# /fonts/* is unhashed with a 7-day TTL (owner-approved 2026-10-19): font files are stable; if one
# ever changes, RENAME it (e.g. -v2) for an instant cache-bust — the TTL is only the fallback.
/fonts/*
  Cache-Control: public, max-age=604800

# The prayer-times JSON is fetched at runtime by the city pages. It is regenerated per city
# (and per year window), so it gets a short TTL plus a long stale-while-revalidate: a city visit
# revalidates in the background instead of blocking on the network.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The OG cards are generated per surah and only change when the card design changes; they are
# unhashed, so a design change has to bump the generator's file names (same rule as /fonts/*).
/og/*
  Cache-Control: public, max-age=31536000, immutable
