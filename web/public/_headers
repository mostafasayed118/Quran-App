/*
# script-src no longer allows 'unsafe-inline' (owner-ordered 2026-10-20; the 2026-10-19
# accepted risk is closed). The six inline scripts that remain are allowed by their exact
# sha256 of the shipped bytes instead:
#   sha256-y+FotC7GvV2idFnvsHR8JtbzfaPMXDmGo1GwuHabR48=  BaseLayout theme bootstrap  (every page)
#   sha256-n02J/sGih6I+q0Kyx2TU0X2d9oJeTTflM4KQd54nGIA=  ThemeToggle wiring           (every page)
#   sha256-Ww6sTKppW0rgelzPh/PhX/+YvgITXp0bdCjH3Ryru6I=  BaseLayout JSON-LD           (every page; inert data)
#   sha256-G5aS6TaYBTD7E/8OuihOhkAzs/Re+fUZuixw0warWkY=  404 AR/EN swap + switch      (dist/404.html)
#   sha256-0boEBuwJjk7eoujXOmvvT+avW+qwl8oqdkohBNZjTi8=  reader reading view/layout (the surah pages)
#   sha256-6v76vjvJjMq/WtmOQjM7kro8Di+dVSihucPojR1yyvQ=  service-worker registration (every page; on load)
# The four paint-blocking ones (theme, toggle label, 404 locale, reading view) must run before
# the first paint, so they cannot be deferred into a module; and Astro's build inlines every
# component script under 4KB, so converting them would not yield an external 'self' asset
# either. The JSON-LD is inert data and the SW registration defers to window load; both are
# hashed because they are still script elements. `npm run budget` recomputes these hashes from
# the built HTML and fails on drift. The service worker itself is an external /sw.js asset,
# covered by `script-src 'self'`.
# style-src needs no 'unsafe-inline' either: astro.config.mjs sets
# `build.inlineStylesheets: 'never'`, so every component stylesheet ships as a hashed
# /_astro/*.css file.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-y+FotC7GvV2idFnvsHR8JtbzfaPMXDmGo1GwuHabR48=' 'sha256-n02J/sGih6I+q0Kyx2TU0X2d9oJeTTflM4KQd54nGIA=' 'sha256-Ww6sTKppW0rgelzPh/PhX/+YvgITXp0bdCjH3Ryru6I=' 'sha256-G5aS6TaYBTD7E/8OuihOhkAzs/Re+fUZuixw0warWkY=' 'sha256-0boEBuwJjk7eoujXOmvvT+avW+qwl8oqdkohBNZjTi8=' 'sha256-6v76vjvJjMq/WtmOQjM7kro8Di+dVSihucPojR1yyvQ='; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self' https://mp3quran.net https://*.mp3quran.net; connect-src 'self' https://mp3quran.net https://*.mp3quran.net https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# /fonts/* is unhashed with a 7-day TTL (owner-approved 2026-10-19): font files are stable; if one
# ever changes, RENAME it (e.g. -v2) for an instant cache-bust — the TTL is only the fallback.
/fonts/*
  Cache-Control: public, max-age=604800

# The prayer-times JSON is fetched at runtime by the city pages. It is regenerated per city
# (and per year window), so it gets a short TTL plus a long stale-while-revalidate: a city visit
# revalidates in the background instead of blocking on the network.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The OG cards are generated per surah and only change when the card design changes; they are
# unhashed, so a design change has to bump the generator's file names (same rule as /fonts/*).
/og/*
  Cache-Control: public, max-age=31536000, immutable
