    {
      "name": "surahs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"surahs\" (\"id\" INTEGER NOT NULL, \"name_ar\" TEXT NOT NULL, \"name_en\" TEXT NOT NULL, \"revelation_type\" TEXT NOT NULL, \"ayah_count\" INTEGER NOT NULL, \"pages_start\" INTEGER NOT NULL, \"pages_end\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ayahs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ayahs\" (\"id\" INTEGER NOT NULL, \"surah_id\" INTEGER NOT NULL, \"number_in_surah\" INTEGER NOT NULL, \"juz\" INTEGER NOT NULL, \"page\" INTEGER NOT NULL, \"line_start\" INTEGER NULL, \"line_end\" INTEGER NULL, \"text_uthmani\" TEXT NOT NULL, \"text_imlaei\" TEXT NOT NULL, \"sajda\" INTEGER NOT NULL DEFAULT 0 CHECK (\"sajda\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"ayah_id\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "khatma_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"khatma_progress\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"ayah_id\" INTEGER NOT NULL, \"target_pages\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "prayer_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"prayer_log\" (\"day\" INTEGER NOT NULL, \"fajr\" INTEGER NOT NULL DEFAULT 0 CHECK (\"fajr\" IN (0, 1)), \"dhuhr\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dhuhr\" IN (0, 1)), \"asr\" INTEGER NOT NULL DEFAULT 0 CHECK (\"asr\" IN (0, 1)), \"maghrib\" INTEGER NOT NULL DEFAULT 0 CHECK (\"maghrib\" IN (0, 1)), \"isha\" INTEGER NOT NULL DEFAULT 0 CHECK (\"isha\" IN (0, 1)), PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "installed_packs",
      "sql": [
